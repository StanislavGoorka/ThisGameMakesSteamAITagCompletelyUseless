expect_success(overdrive_leading_zeroes "0 10847651942247465451\n1 1 0 6165481053362014949\n" 10 0 overdrive:001)
expect_success(overdrive_boundary_targets "0 10847651942247465451\n1 0 0 10847651942247465451\n2 0 0 10847651942247465451\n" 10 0 overdrive:0 overdrive:48)
foreach(token IN ITEMS overdrive overdrive=1 overdrive: overdrive:49 overdrive:-1 overdrive:+1 overdrive:1x "overdrive: 1" "overdrive:1 " overdrive:18446744073709551616)
    expect_error("token_${token}" 10 0 wait overdrive:1 "${token}")
