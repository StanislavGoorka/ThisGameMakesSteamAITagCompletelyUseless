foreach(token IN ITEMS overdrive overdrive=1 overdrive: overdrive:49 overdrive:-1 overdrive:+1 overdrive:1x "overdrive: 1" "overdrive:1 " overdrive:18446744073709551616)
    expect_error("token_${token}" 7 0 wait overdrive:1 "${token}")
