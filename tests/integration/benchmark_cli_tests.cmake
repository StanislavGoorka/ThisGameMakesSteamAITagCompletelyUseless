cmake_minimum_required(VERSION 3.26)
execute_process(COMMAND "${BENCHMARK_EXE}" RESULT_VARIABLE code OUTPUT_VARIABLE report)
if(NOT code STREQUAL "0")
    message(FATAL_ERROR "Benchmark contract failed: ${code}; ${report}")
endif()
foreach(family RANGE 0 2)
    foreach(rejected RANGE 0 1)
        if(NOT report MATCHES "case ${family} ${rejected} 3000 [0-9]+ [0-9]+\n")
            message(FATAL_ERROR "Missing corpus/sample/percentile row: ${report}")
        endif()
    endforeach()
endforeach()
if(NOT report MATCHES "digest [0-9]+\n$")
    message(FATAL_ERROR "Missing observable result digest")
endif()
execute_process(COMMAND "${BENCHMARK_EXE}" unknown RESULT_VARIABLE code OUTPUT_VARIABLE output)
if(code STREQUAL "0" OR NOT output STREQUAL "")
    message(FATAL_ERROR "Invalid arguments accepted")
endif()
