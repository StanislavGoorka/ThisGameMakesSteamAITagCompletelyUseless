cmake_minimum_required(VERSION 3.26)
execute_process(COMMAND "${CORPUS_EXE}" RESULT_VARIABLE code OUTPUT_VARIABLE report)
if(NOT code STREQUAL "0")
    message(FATAL_ERROR "Corpus rejected entries: ${code}; ${report}")
endif()
execute_process(COMMAND "${CORPUS_EXE}" RESULT_VARIABLE code OUTPUT_VARIABLE repeated)
if(NOT code STREQUAL "0" OR NOT repeated STREQUAL report)
    message(FATAL_ERROR "Corpus report is not repeatable")
endif()
string(REPLACE "\n" ";" rows "${report}")
list(LENGTH rows count)
if(NOT count EQUAL 1004)
    message(FATAL_ERROR "Missing corpus rows: ${count}")
endif()
foreach(index RANGE 0 999)
    math(EXPR row_index "${index}+2")
    list(GET rows ${row_index} row)
    set(seed ${index})
    if(index EQUAL 999)
        set(seed 18446744073709551615)
    endif()
    if(NOT row MATCHES "^${seed} 0 [1-4][0-9] 0 0 0 0 0 0 0$")
        message(FATAL_ERROR "Rejected or missing seed/scenario: ${row}")
    endif()
endforeach()
list(GET rows 1002 summary)
if(NOT summary STREQUAL "summary 1000 0 0")
    message(FATAL_ERROR "Unexpected summary: ${summary}")
endif()
execute_process(COMMAND "${CORPUS_EXE}" unknown RESULT_VARIABLE code OUTPUT_VARIABLE output)
if(code STREQUAL "0" OR NOT output STREQUAL "")
    message(FATAL_ERROR "Invalid CLI input accepted")
endif()
message(STATUS "PASS: 1000 certificates, 7000 debt scenarios, repeatable CLI report")
